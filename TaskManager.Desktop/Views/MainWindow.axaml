<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TaskManager.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="TaskManager.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Менеджер задач"
        Width="900"
        Height="560"
        MinWidth="680"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding LoadCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
    </Window.KeyBindings>

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#1F2328"
                           Text="Мои задачи" />
                <TextBlock Classes="hint"
                           Text="{Binding TaskCount, StringFormat='Всего задач: {0}'}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="hint"
                           IsVisible="{Binding IsBusy}"
                           Text="Обновление…"
                           VerticalAlignment="Center" />
                <Button Command="{Binding LoadCommand}" Content="Обновить" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card" Padding="16">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Name="TitleInput"
                             Grid.Column="0"
                             Classes="field"
                             Classes.invalid="{Binding HasTitleError}"
                             KeyDown="OnTitleInputKeyDown"
                             MinHeight="36"
                             PlaceholderText="Что нужно сделать?"
                             Text="{Binding NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1"
                            Classes="primary"
                            Command="{Binding AddCommand}"
                            Content="Добавить"
                            MinHeight="36"
                            MinWidth="110" />
                </Grid>

                <TextBlock Classes="fieldError"
                           IsVisible="{Binding HasTitleError}"
                           Text="{Binding TitleValidationMessage}" />

                <TextBlock Classes="hint"
                           Text="Enter — добавить · Esc — очистить · ↑↓ — выбрать · Space — отметить · Delete — удалить" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Classes="alert"
                IsVisible="{Binding HasError}">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold"
                           Foreground="#B3261E"
                           Text="Не удалось выполнить операцию" />
                <TextBlock Foreground="#5F1A16"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Classes="card" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">

                <Border Grid.Row="0" Classes="headerRow">
                    <Grid ColumnDefinitions="48,*,170,150,100">
                        <TextBlock Grid.Column="0" />
                        <TextBlock Grid.Column="1" Classes="headerCell" Margin="4,0" Text="Задача" />
                        <TextBlock Grid.Column="2" Classes="headerCell" Margin="4,0" Text="Состояние" />
                        <TextBlock Grid.Column="3" Classes="headerCell" Margin="4,0" Text="Создано" />
                        <TextBlock Grid.Column="4" />
                    </Grid>
                </Border>

                <Panel Grid.Row="1">
                    <TextBlock Classes="emptyHint"
                               IsVisible="{Binding !HasTasks}"
                               Text="Задач пока нет. Добавьте первую выше." />

                    <ListBox Name="TasksList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Tasks}"
                             SelectedItem="{Binding SelectedItem}">
                        <ListBox.KeyBindings>
                            <KeyBinding Gesture="Space" Command="{Binding ToggleSelectedCommand}" />
                        </ListBox.KeyBindings>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskItemViewModel">
                                <Border Classes="tableRow">
                                    <Grid ColumnDefinitions="48,*,170,150,100">
                                        <CheckBox Grid.Column="0"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Classes="titleCell"
                                                   Classes.done="{Binding IsCompleted}"
                                                   Margin="4,0"
                                                   Text="{Binding Title}" />

                                        <TextBlock Grid.Column="2"
                                                   Classes="titleCell"
                                                   Foreground="#374151"
                                                   Margin="4,0"
                                                   Text="{Binding StateText}" />

                                        <TextBlock Grid.Column="3"
                                                   Foreground="#6B7280"
                                                   Margin="4,0"
                                                   Text="{Binding CreatedAtText}"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="4"
                                                Classes="link"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteCommand}"
                                                CommandParameter="{Binding}"
                                                Content="Удалить"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </Grid>
        </Border>
    </Grid>
</Window>